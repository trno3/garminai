{
  "name": "pi-dev Garmin",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "runServices": ["dev", "postgres"],
  "workspaceFolder": "/workspaces/garmin",
  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:2": { "version": "24" },
    "ghcr.io/sliekens/devcontainer-features/pi:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "configureZshAsDefaultShell": true,
      "ohMyZshTheme": "robbyrussell",
      "upgradePackages": false,
      "username": "vscode"
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "git docker docker-compose node npm go zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting",
      "username": "vscode"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "go.useLanguageServer": true,
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.angular/**": true
        }
      }
    }
  },

  "forwardPorts": [4200, 8080, 5432],
  "portsAttributes": {
    "4200": { "label": "Angular (ng serve)", "onAutoForward": "openPreview" },
    "8080": { "label": "Go API", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}